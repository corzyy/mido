#!/usr/bin/env bash
# mido-dns [DHCP|Cloudflare|Google|Custom]: print the DNS provider of the active connection, or set
# one and reconnect. Custom asks for the servers.
set -u
export LC_ALL=C

dev=$(ip route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
conn=$(nmcli -t -g GENERAL.CONNECTION device show "$dev" 2>/dev/null)
[[ -n "$conn" ]] || exit 1

if [[ $# -eq 0 ]]; then
  dns=$(nmcli -t -g ipv4.dns connection show "$conn" | tr ',' ' ' | xargs)
  case "$dns" in
    "") echo DHCP ;;
    "1.1.1.1 1.0.0.1" | "1.1.1.1") echo Cloudflare ;;
    "8.8.8.8 8.8.4.4" | "8.8.8.8") echo Google ;;
    *) echo Custom ;;
  esac
  exit 0
fi

case "$1" in
  DHCP) v4="" v6="" ignore=no ;;
  Cloudflare) v4="1.1.1.1 1.0.0.1" v6="2606:4700:4700::1111 2606:4700:4700::1001" ignore=yes ;;
  Google) v4="8.8.8.8 8.8.4.4" v6="2001:4860:4860::8888 2001:4860:4860::8844" ignore=yes ;;
  Custom)
    read -r -p "DNS servers (space separated, empty for DHCP): " v4
    v6="" ignore=yes
    [[ -n "$v4" ]] || ignore=no
    ;;
  *) exit 2 ;;
esac

nmcli connection modify "$conn" ipv4.dns "$v4" ipv4.ignore-auto-dns "$ignore" ipv6.dns "$v6" ipv6.ignore-auto-dns "$ignore" || exit 1
nmcli connection up "$conn" >/dev/null
