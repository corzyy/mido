#!/usr/bin/env bash
# mido-network-status: describe the interface the default route leaves through, one
# "key<TAB>value" line each. Prints nothing when there is no route. With --verbose it also
# measures the latency to the gateway and to the internet.
set -u
export LC_ALL=C

verbose=false
[[ "${1:-}" == "--verbose" ]] && verbose=true

dev=$(ip route show default 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit }}')
[[ -n "$dev" ]] || exit 0

field() { printf '%s\t%s\n' "$1" "$2"; }

type=ethernet
[[ -d "/sys/class/net/$dev/wireless" ]] && type=wifi

addr=$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4; exit}')
gateway=$(ip route show default dev "$dev" 2>/dev/null | awk '{print $3; exit}')

field iface "$dev"
field type "$type"
field ip "${addr%/*}"
[[ "$addr" == */* ]] && field prefix "${addr#*/}"
field gateway "$gateway"

if [[ "$type" == wifi ]]; then
  link=$(iw dev "$dev" link 2>/dev/null)
  ssid=$(awk -F'SSID: ' '/SSID:/ {print $2; exit}' <<<"$link")
  signal=$(awk '/signal:/ {print $2; exit}' <<<"$link")
  freq=$(awk '/freq:/ {print $2; exit}' <<<"$link")
  bitrate=$(awk '/tx bitrate:/ {print $3; exit}' <<<"$link")
  field ssid "$ssid"
  [[ -n "$signal" ]] && field signal "$signal"
  [[ -n "$freq" ]] && field freq "${freq%.*}"
  [[ -n "$bitrate" ]] && field bitrate "$bitrate"
else
  speed=$(cat "/sys/class/net/$dev/speed" 2>/dev/null)
  [[ -n "$speed" && "$speed" -gt 0 ]] 2>/dev/null && field speed "$speed"
  duplex=$(cat "/sys/class/net/$dev/duplex" 2>/dev/null)
  [[ -n "$duplex" ]] && field duplex "$duplex"
fi

field rx_bytes "$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null || echo 0)"
field tx_bytes "$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null || echo 0)"

if $verbose; then
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  ping_ms() { ping -n -c 1 -W 1 -I "$dev" "$1" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p' | head -n 1; }
  [[ -n "$gateway" ]] && ping_ms "$gateway" >"$tmp/router" &
  ping_ms 1.1.1.1 >"$tmp/internet" &
  wait
  router=$(cat "$tmp/router" 2>/dev/null)
  internet=$(cat "$tmp/internet" 2>/dev/null)
  field router_ping_ms "${router:--1}"
  field internet_ping_ms "${internet:--1}"
fi
